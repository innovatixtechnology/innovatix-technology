# Contact form (https://web3forms.com). Create a free access key for the inbox
# that should receive enquiries, then copy this file to .env.local.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Set to true once the Web3Forms Pro plan is active, to copy every enquiry to
# the addresses in ENQUIRY_CC (src/lib/content.ts).
NEXT_PUBLIC_WEB3FORMS_PRO=false
